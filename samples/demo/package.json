{
  "name": "@pact-network/sample-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live runnable demos for Pact Network — scorecard monitor loop and insured-agent Phase 3 flow.",
  "scripts": {
    "build:deps": "pnpm --filter @q3labs/pact-monitor --filter @q3labs/pact-insurance build",
    "monitor": "pnpm run build:deps && tsx monitor.ts",
    "insurance-basic": "pnpm run build:deps && tsx insurance-basic.ts",
    "insured-agent": "pnpm run build:deps && tsx insured-agent.ts",
    "external-agent": "pnpm run build:deps && tsx external-agent.ts",
    "monitor-plus-insurance": "pnpm run build:deps && tsx monitor-plus-insurance.ts"
  },
  "dependencies": {
    "@q3labs/pact-insurance": "workspace:*",
    "@q3labs/pact-monitor": "workspace:*",
    "@solana/kit": "^6.10.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "dotenv": "^16.6.1",
    "pg": "^8.23.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
