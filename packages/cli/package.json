{
  "name": "@q3labs/pact-cli",
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "pact": "dist/pact.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "_build:deps": "pnpm --filter @q3labs/pact-protocol-v1-client build",
    "_check:version": "node -e \"const a=require('./package.json').version,b=require('fs').readFileSync('src/index.ts','utf8').match(/VERSION\\s*=\\s*\\\"([^\\\"]+)/)[1]; if(a!==b){console.error('VERSION drift: package.json='+a+' src/index.ts='+b);process.exit(1)}\"",
    "prebuild": "pnpm run _build:deps && pnpm run _check:version",
    "build": "bun build src/index.ts --target=node --format=esm --outfile dist/pact.js && node scripts/fix-shebang.mjs dist/pact.js && chmod +x dist/pact.js",
    "pretest": "pnpm run _build:deps",
    "test": "bun test",
    "pretypecheck": "pnpm run _build:deps",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured yet'"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pact-network",
    "solana",
    "cli",
    "ai-agent",
    "x402"
  ],
  "license": "MIT",
  "author": "Pact Network",
  "devDependencies": {
    "@q3labs/pact-monitor": "workspace:*",
    "@q3labs/pact-protocol-v1-client": "workspace:*",
    "@solana/kit": "^2.3.0",
    "@solana/web3.js": "^1.98.4",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "bs58": "^6.0.0",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "hono": "^4.13.2",
    "js-yaml": "^4.3.1",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.3",
    "viem": "^2.55.16"
  }
}
