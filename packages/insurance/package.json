{
  "name": "@q3labs/pact-insurance",
  "version": "0.3.0",
  "description": "TypeScript SDK for Pact Network's on-chain parametric insurance program on Solana — enable insurance, top up delegations, submit claims, and query pool state.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pactnetwork/pact-monitor.git",
    "directory": "packages/insurance"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "idl",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pact-network",
    "solana",
    "anchor",
    "insurance",
    "parametric",
    "x402",
    "agent"
  ],
  "homepage": "https://pactnetwork.io",
  "bugs": {
    "url": "https://pactnetwork.io"
  },
  "license": "MIT",
  "author": "Pact Network",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "codama:generate": "node ./scripts/codama-generate.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.1.2",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.10.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.4",
    "@codama/renderers-js": "^2.3.1",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.1",
    "codama": "^1.10.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
